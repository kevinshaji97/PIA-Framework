# Copy this file to .env (or ~/.pia/.env) and fill in the key for the provider you use.
# .env is git-ignored: never commit real keys. Variables already set in your shell take precedence.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional defaults (equivalent to the --provider / --model / --base-url options)
# PIA_PROVIDER=anthropic
# PIA_MODEL=
# PIA_BASE_URL=

# Where assessment history is stored (default: ~/.pia/assessments.db)
# PIA_DB=~/.pia/assessments.db
